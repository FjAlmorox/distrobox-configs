# ==============================================================================
# sandbox-versions.env - Canonical default runtime versions (single source of truth)
# ==============================================================================
# This file is the ONE place that defines the default runtime version for each
# sandbox. Both the provisioning scripts (<name>/setup.sh) and the structural
# validator (tests/validate-sandboxes.sh) read these values, so documentation
# and code can never silently drift apart.
#
# Precedence at provisioning time (highest wins):
#   1. A value set by the user in the repository .env
#   2. The canonical default defined here
#   3. A hardcoded fallback inside the sandbox's setup.sh (safety net only)
#
# Keep values unquoted and simple (NAME=value); this file is sourced by bash
# and parsed line-by-line by the validator.
# ==============================================================================

# node-dev: default Node.js LTS line installed via fnm
NODE_DEFAULT_VERSION=24

# python-dev: default CPython version installed via uv
PYTHON_DEFAULT_VERSION=3.13

# java-dev: default Java LTS installed via SDKMAN (Eclipse Temurin)
JAVA_DEFAULT_VERSION=21

# android-dev: default Android SDK Platform / compile API level
ANDROID_COMPILE_SDK=35
