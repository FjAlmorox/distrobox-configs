# ==============================================================================
# .env.example - Local Configuration Template for Distrobox Environments
# ==============================================================================
# Copy this file as '.env' in the repository root to apply local customizations.
# The '.env' file is strictly ignored by Git. NEVER commit private keys or secrets.
# All variables below are optional; sensible defaults are applied automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Infrastructure Layer (Evaluated by create.sh, enter.sh, distrobox.ini)
# ------------------------------------------------------------------------------
# Base Fedora release tag for all Distrobox containers (default: 44)
# FEDORA_VERSION=44

# Custom base container image (overrides FEDORA_VERSION if specified)
# DISTROBOX_BASE_IMAGE="registry.fedoraproject.org/fedora-toolbox:44"

# Path to the host Workspace directory mounted inside containers (default: $HOME/Workspace)
# WORKSPACE_DIR="${HOME}/Workspace"

# Storage location for isolated container homes (default: $HOME/.local/share/distrobox-homes)
# Useful for storing homes on a fast secondary NVMe drive (e.g. /mnt/nvme/distrobox-homes)
# DISTROBOX_HOMES_DIR="${HOME}/.local/share/distrobox-homes"

# Hardware acceleration and passthrough flags.
# By default create.sh AUTO-DETECTS /dev/kvm and /dev/dri and passes each through
# only when present on the host (portable across desktops, cloud VMs, and CI).
# Set this variable to override detection explicitly:
#   • Force specific devices:  DISTROBOX_ADDITIONAL_FLAGS="--device /dev/kvm --device /dev/dri"
#   • Force none (headless):   DISTROBOX_ADDITIONAL_FLAGS=""
# DISTROBOX_ADDITIONAL_FLAGS="--device /dev/kvm --device /dev/dri"

# Native NVIDIA GPU passthrough (0 = false, 1 = true, default: 0)
# DISTROBOX_NVIDIA=0

# ------------------------------------------------------------------------------
# 2. Global Desktop & GUI Master Toggle (Applies to ALL sandboxes)
# ------------------------------------------------------------------------------
# Set to 'false' to switch ALL environments into ultra-fast Headless / CLI mode.
# When 'false':
#   • java-dev: skips all GTK3, X11, desktop fonts, and audio libraries.
#   • android-dev: skips Mesa, Vulkan, audio, emulator package, and the 1.5 GB AVD.
#   • future sandboxes (python, rust): automatically inherit headless mode.
# INSTALL_GUI=true

# ------------------------------------------------------------------------------
# 3. Network & Corporate Proxy Settings (Optional)
# ------------------------------------------------------------------------------
# HTTP_PROXY="http://proxy.example.com:8080"
# HTTPS_PROXY="http://proxy.example.com:8080"
# NO_PROXY="localhost,127.0.0.1"

# ------------------------------------------------------------------------------
# 4. Java / JVM Sandbox Configuration (java-dev/setup.sh)
# ------------------------------------------------------------------------------
# Default Java LTS version to install via SDKMAN! (default: 21)
# JAVA_DEFAULT_VERSION=21

# Complementary build tools (default: true)
# INSTALL_GRADLE=true
# INSTALL_MAVEN=true
# INSTALL_KOTLIN=true

# Memory flags for Gradle daemon / compiler (optional)
# GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx4g"

# ------------------------------------------------------------------------------
# 5. Android Sandbox Configuration (android-dev/setup.sh)
# ------------------------------------------------------------------------------
# Target Android SDK API version to compile against (default: 35)
# ANDROID_COMPILE_SDK=35

# Android Build-Tools version (default: 35.0.0)
# ANDROID_BUILD_TOOLS="35.0.0"

# Granular emulator toggle (defaults to INSTALL_GUI if not explicitly set)
# Set to 'false' if you want GUI libs but do NOT want the 1.5 GB mobile emulator
# INSTALL_EMULATOR=true

# Android Emulator system image API level (default: 34)
# ANDROID_EMULATOR_API=34

# Android Virtual Device (AVD) name and hardware profile
# AVD_NAME="Pixel_6_API_34"
# AVD_DEVICE_PROFILE="pixel_6"

# ------------------------------------------------------------------------------
# 6. Python Sandbox Configuration (python-dev/setup.sh)
# ------------------------------------------------------------------------------
# Default Python version to install via uv (default: 3.13)
# PYTHON_DEFAULT_VERSION="3.13"

# Install standard developer CLI tools (ruff, mypy, pytest, ipython, pre-commit) (default: true)
# INSTALL_PYTHON_DEV_TOOLS=true

# ------------------------------------------------------------------------------
# 7. Node.js & Frontend Sandbox Configuration (node-dev/setup.sh)
# ------------------------------------------------------------------------------
# Default Node.js LTS version to install via fnm (default: 24)
# NODE_DEFAULT_VERSION="24"

# Install Bun runtime and package manager (default: true)
# INSTALL_BUN=true

# Install headless browser testing libraries for Playwright/Cypress (default: true)
# INSTALL_BROWSER_DEPS=true


